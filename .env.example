# CPCT AI Agent Configuration
# Replace with your Gemini API Key for Gemini 2.5 Flash Vision & Explanation Engine
GEMINI_API_KEY=your_gemini_api_key_here

# Model options: gemini-2.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-2.5-flash

# Repeat question vector similarity threshold (0.0 to 1.0)
SIMILARITY_REPEAT_THRESHOLD=0.82

